# =============================================================================
# MLIR / LLVM 编译产物（本仓库根目录）
# 说明：已纳入版本管理的源文件（如 llvm-project 内的 *.ll、*.mlir 测试）
#       不受 .gitignore 影响；以下规则主要忽略构建树与工具输出。
# =============================================================================

# --- CMake / Ninja 构建目录 ---
build/
build-*/
cmake-build-*/
out/
.cmake/

# CMake 生成文件（通常出现在 build 目录内）
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
_deps/

# Ninja
.ninja_deps
.ninja_log
build.ninja
rules.ninja

# 嵌套在 llvm-project 内的 out-of-tree / in-tree 构建（补充其自带 .gitignore）
llvm-project/build/
llvm-project/build*/

# mlir-toy 等子项目的本地构建
mlir-toy/build/
mlir-toy/cmake-build-*/

# mlir-tutorial 本地 MLIR/LLVM 安装前缀（由 llvm-project 构建生成）
mlir-tutorial/install/
mlir-tutorial/build/
mlir-tutorial/cmake-build-*/

# --- 目标文件、静态库、动态库、可执行文件 ---
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.pdb
*.ilk
*.exp

# --- LLVM IR / Bitcode（编译器输出；非源码树中已跟踪的测试输入）---
*.ll
*.bc

# --- MLIR 专用输出 ---
*.mlirbc
*.mlir.tmp

# 常见 pass / 工具 dump 目录（按需生成，非手写源码）
/dump/
/output/
/test-output/

# TableGen / mlir-tblgen 等在构建目录生成的头文件片段（若落在 build 外）
*Gen.cpp.inc
*Gen.h.inc
*Dialect.cpp.inc
*Dialect.h.inc
*Types.cpp.inc
*Types.h.inc
*Ops.cpp.inc
*Ops.h.inc
*Interfaces.cpp.inc
*Interfaces.h.inc

# --- 工具链与 IDE ---
compile_commands.json
compile_commands.json.tmp
tablegen_compile_commands.yml
.cache/
.clangd/
.idea/
.vscode/
.vs/

# 编辑器临时文件
*~
*.sw?
*.orig
*.rej

# --- 日志 ---
*.log
